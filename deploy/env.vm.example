# The server's secrets. deploy/setup-server.sh copies this to .env in the project
# folder on the SERVER, where you fill it in. .env is gitignored and made readable
# only by you. Never commit it, and never paste its values anywhere.

# The address people open, pointed at this server by an A record.
DOMAIN=middleberth.samartiwari.me
# Let's Encrypt writes here if the certificate is about to expire unrenewed.
CERT_EMAIL=

# Anyone who knows this can mint a token for any user. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
# Generate with:  openssl rand -hex 24
# Set it before the FIRST start: the databases keep whatever password they were
# created with.
POSTGRES_PASSWORD=

# Must stay false on a public server. compose.vm.yml forces it off as well.
AUTH_DEMO_TOKENS=false

# stub = the fake gateway. live = the real Razorpay API, with TEST mode keys from
# Dashboard -> Settings -> API Keys (rzp_test_...). No real money moves in test mode.
RAZORPAY_MODE=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A long random string you invent (openssl rand -hex 24), entered as the same value
# in Dashboard -> Settings -> Webhooks for https://DOMAIN/webhooks/razorpay,
# event payment.captured. It is not the API secret.
RAZORPAY_WEBHOOK_SECRET=
# How often unpaid orders are checked with Razorpay. Their API is rate limited.
RECONCILE_INTERVAL=PT60S

# log = mail is written to the log. smtp = really sent, with MAIL_HOST, MAIL_PORT,
# MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM set too (see deploy/going-live.md).
MAIL_MODE=log
