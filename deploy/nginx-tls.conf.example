# The front door with HTTPS, for the VM.
#
# Razorpay will not send webhooks to plain HTTP, so going live needs this. It is
# an EXAMPLE, not wired into docker compose: nginx refuses to start if the
# certificate files are not there, and on a laptop they are not.
#
# To use it:
#
#   1. point a DNS A record at the VM  (a free DuckDNS subdomain is enough)
#   2. sudo certbot certonly --standalone -d middleberth.example.com
#   3. copy this file to deploy/nginx.conf, replace the two domain names
#   4. mount /etc/letsencrypt into the nginx container and publish 443
#   5. set the webhook URL in the Razorpay dashboard to
#      https://middleberth.example.com/webhooks/razorpay
#
# certbot renews on its own. nginx has to be reloaded after a renewal, which the
# certbot deploy hook can do.

upstream gateway {
    server gateway:8000;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# Everything on port 80 is redirected, except the challenge certbot uses to prove
# the domain is yours.
server {
    listen 80;
    server_name middleberth.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name middleberth.example.com;

    ssl_certificate     /etc/letsencrypt/live/middleberth.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/middleberth.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    location / {
        proxy_pass http://gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Nobody from outside gets to claim they are a user.
        proxy_set_header X-User-Id "";

        proxy_connect_timeout 2s;
        proxy_read_timeout    30s;
    }
}
